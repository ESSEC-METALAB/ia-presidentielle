# Copy to .env and fill in. .env is never committed.
# Nothing here is needed for `make demo`, which runs offline on the fake LLM.

# LLM used for annotation: "fake" (deterministic, offline, the default) or "mistral".
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=mistral.
MISTRAL_API_KEY=
# Mistral model id. A config value, chosen when the Mistral adapter is written against
# the provider's current documentation.
MISTRAL_MODEL=

# Contact address sent in the User-Agent (CLAUDE.md §7.2). Required for live collection.
CONTACT_EMAIL=

# SQLite database.
DATABASE_PATH=data/observatoire.db

# structlog level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
