# Copy to .env and fill in. .env is never committed. Nothing here is needed for `make site`.
# Values may be quoted; `export KEY=value` and trailing `# comments` are accepted.

# LLM used for annotation: "mistral", or "fake" (the default: a dry run that writes nothing).
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=mistral.
MISTRAL_API_KEY=
# Mistral model id. Prefer a dated id over a "-latest" alias: the id is part of the
# annotator's version, so with an alias the model could change under the same version.
# Changing it re-annotates every passage.
MISTRAL_MODEL=

# SQLite database.
DATABASE_PATH=data/observatoire.db

# structlog level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Daily update (scripts/daily.sh, installed at DAILY_TIME by `make schedule`) ---------
# Local time of the morning update.
DAILY_TIME=08:00
# 1: also import what the previous version (branch `daily`, GitHub Actions) collected.
DAILY_IMPORT_LEGACY=1
# 1: `git pull --ff-only` before each update, to receive config changes from the team.
DAILY_GIT_PULL=0
# Recorded answers replayed when LLM_PROVIDER is not mistral.
ANNOTATION_RESPONSES=annotations/2026-11-03-brouillon.jsonl
# Port of the local site (http://localhost:8000), served on this machine only.
SITE_PORT=8000

# --- On a server (Dockerfile, `observatoire web`) -----------------------------------------
# Least time between two refreshes asked with the site's "Actualiser" button. A refresh
# reads the candidates' sites again under the Metalab's name: keep it polite.
REFRESH_COOLDOWN_MINUTES=10
