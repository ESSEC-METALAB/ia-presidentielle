{# One claim. The three voices stay visually separate: his words, our neutral
   restatement, our labelled explanation. #}
<article class="claim" style="--c:var(--{{ {'1':'source','2':'party','3':'press'}[claim.tier.value] }})">
  <div class="who">
    <b>{{ people[claim.person].name }}</b>
    <span>{{ people[claim.person].party }}</span>
    <span>{% if claim.date %}{{ claim.date }}{% else %}{{ t('date_unknown') }}{% endif %}</span>
    <span>{{ axis_label(claim.axis, locale) }}</span>
    <span{% if not claim.tier_confirmed %} title="{{ t('tier_default') }}"{% endif %}>
      {{ tier_label(claim.tier.value, locale) }}{% if not claim.tier_confirmed %} *{% endif %}</span>
  </div>
  <blockquote lang="fr" cite="{{ claim.citation_url() }}">« {{ claim.quote_fr }} »</blockquote>
  {%- if locale != 'fr' %}
  <p class="gloss">[{{ t('translation') }}] {{ claim.quote_gloss_en }}</p>
  {%- endif %}
  <p class="position">{{ claim.position_fr if locale == 'fr' else claim.position_en }}</p>
  <div class="context">
    <span class="lbl">{{ t('context') }}</span>
    {{ claim.contexte_fr if locale == 'fr' else claim.contexte_en }}
  </div>
  <div class="src">
    <span>{{ t('source') }}:</span>
    <a href="{{ claim.citation_url() }}" rel="nofollow noopener">{{ claim.source_url|hostname }}</a>
    {%- if claim.archive_url %}<span>·</span><a href="{{ claim.archive_url }}" rel="nofollow noopener">{{ t('archived') }}</a>{% endif %}
    <span>·</span><span>{{ t('verified') }} {{ claim.last_verified }}</span>
  </div>
</article>
